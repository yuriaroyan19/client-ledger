# Copy to `.env` and fill in the blanks:  cp .env.example .env
# Never commit `.env`. Every variable is documented in README.md → "Configuration".

# --- Database -------------------------------------------------------------
POSTGRES_USER=ledger
# Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=client_ledger
# Host port for local tools (bound to 127.0.0.1 only).
DB_PORT=5433

# --- Initial administrator (created on first start, never overwritten) ----
ADMIN_EMAIL=admin@example.com
# At least 12 characters.
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Insert sample clients and movements into an empty database.
SEED_DEMO_DATA=true
# Set to true for ONE run to rotate the admin password (also revokes the admin's sessions):
#   docker compose run --rm -e ADMIN_RESET_PASSWORD=true migrate
ADMIN_RESET_PASSWORD=false

# --- Sessions ---------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- Rate limits (per API instance) ----------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX_PER_IP=20
RATE_LIMIT_LOGIN_MAX_FAILURES_PER_EMAIL=5
# Per IP, only for requests without a session (login, health, unknown routes).
RATE_LIMIT_ANONYMOUS_MAX_PER_MINUTE=600
# Per signed-in session (so one user can never exhaust another's budget).
RATE_LIMIT_SESSION_MAX_PER_MINUTE=300
# Failed session-token checks per IP per minute; then unknown tokens are refused before the database.
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=30

# --- Network ----------------------------------------------------------------
# Reverse proxies in front of the web app that append to X-Forwarded-For (0 = exposed directly).
TRUSTED_PROXY_HOPS=0
# Proxy addresses the API trusts for X-Forwarded-For (Express "trust proxy" syntax).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Comma-separated browser origins allowed to call the API directly. Empty = none (recommended).
CORS_ORIGINS=

# --- Ports ------------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000

# --- Misc -------------------------------------------------------------------
# Disable in production deployments that should not publish API docs.
SWAGGER_ENABLED=true
LOG_LEVEL=info
# Human-readable logs for local development (API only).
LOG_PRETTY=false
CURRENCY=USD
# Keep `true`. Set `false` only if you serve the web app over plain HTTP on a non-localhost host.
COOKIE_SECURE=true
