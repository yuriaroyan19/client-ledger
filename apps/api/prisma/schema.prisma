// Database schema — the single source of truth for persistence.
// Conventions: snake_case tables/columns (@@map/@map), UUIDv7 ids, soft deletes via `deleted_at`/`archived_at`.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  clientsCreated   Client[]   @relation("ClientCreatedBy")
  movementsCreated Movement[] @relation("MovementCreatedBy")
  auditLogs        AuditLog[]

  @@map("admins")
}

/// Server-side session. Only a SHA-256 hash of the bearer token is stored.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("sessions")
}

model Client {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  email       String?   @unique
  phone       String?
  notes       String?
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy Admin      @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  movements Movement[]

  @@index([name, id])
  @@index([archivedAt])
  /// Trigram indexes (extension pg_trgm, created in migration search_indexes) serve the substring searches (ILIKE '%term%') on the client list and overview.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_email_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "clients_phone_trgm_idx")
  @@map("clients")
}

enum MovementType {
  EARNING
  EXPENSE

  @@map("movement_type")
}

/// A ledger entry. `amount` is always positive; `type` carries the sign.
model Movement {
  id          String       @id @default(uuid(7)) @db.Uuid
  clientId    String       @map("client_id") @db.Uuid
  type        MovementType
  amount      Decimal      @db.Decimal(14, 2)
  description String
  occurredOn  DateTime     @map("occurred_on") @db.Date
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy Admin  @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clientId, occurredOn])
  @@index([occurredOn])
  @@map("movements")
}

/// Append-only record of security-relevant and mutating actions.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
